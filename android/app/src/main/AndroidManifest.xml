<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Portrait-only, like the iOS build: the onboarding slideshow and the
             Rimon takeovers are fixed 9:16 and the layout is phone-first.
             adjustResize keeps the web layout above the on-screen keyboard
             (the tab bar unmounts while it is up — see TabBar.tsx). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM (board chat / leaderboard nudges from the server): the status-bar
             glyph must be an alpha-only silhouette (scripts/android-stat-icon.mjs
             builds ic_stat_rimon from the brand icon), tinted brand gold, filed
             under the "rimon" channel the app creates (src/lib/native.ts). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_rimon"
        />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary"
        />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="rimon" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Meal photos: the Bless screen's <input type="file" accept="image/*"
         capture="environment"> asks the WebView for the camera; Capacitor's
         file chooser only offers it when this permission is declared. Optional
         hardware — a photo from the gallery works just as well. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- POST_NOTIFICATIONS (Android 13+), RECEIVE_BOOT_COMPLETED and WAKE_LOCK
         are merged in from @capacitor/local-notifications for the mealtime
         reminders; no exact-alarm permission is requested (Play reserves it
         for alarm/calendar apps) — a nudge may land a few minutes late. -->
</manifest>
